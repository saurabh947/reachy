# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Required: Google Gemini API key
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Emotion source: local full-PyTorch model on this machine.
# Path to the fine-tuned two-tower checkpoint (.pt) — required for emotion detection.
EMOTION_MODEL_PATH=../emotion-detection-action/outputs/phase2_best_calibrated.pt
# Optional: torch device for the local model (default: mps on Apple Silicon).
# EMOTION_DEVICE=mps

# Optional: override the default Gemini model for --text mode (default: gemini-3.6-flash)
# Other options: gemini-3.5-flash-lite (cheaper), gemini-3.8-flash (newest)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: voice-mode Live model (default: gemini-3.8-live)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional: Gemini Robotics ER model for the scene tools (default: gemini-robotics-er-2-preview)
# GEMINI_ER_MODEL=gemini-robotics-er-2-preview

# Reachy's long-term memory file (created if missing; relative paths are under the repo)
# REACHY_MEMORY=reachy_memory.md

# Optional: SO-101 follower arm (voice mode). Find ports with .venv-lerobot/bin/lerobot-find-port.
# ARM_PORT=/dev/tty.usbmodemXXXX
# ARM_ID=follower
# Only needed to record gestures with the leader (scripts/arm.sh record wave):
# LEADER_PORT=/dev/tty.usbmodemYYYY
# LEADER_ID=leader

# Optional: arm tasks ("pick up the eraser and put it in the cup"). Gemini Robotics ER 2
# plans each step from Reachy's head camera; the arm server reaches with IK (placo in
# .venv-lerobot, the SO-101 URDF) and needs a taught `ready` pose (scripts/arm.sh teach ready).
#   off (default) | hover (test: the arm only hovers over each target, ~10 cm up and higher
#   over a container, no contact) | on
# ARM_TASKS=off
# Where the arm stands. Measure with a ruler and a square, Reachy's head at neutral:
#  1. Mark the centre of Reachy's foot on the table (the middle of the 12.6 cm foot, under
#     its body-yaw axis) and draw its forward line (the way the head faces at neutral).
#  2. ARM_BASE_X_CM / ARM_BASE_Y_CM: the centre of the arm's base turntable (its shoulder-pan
#     axis), in cm forward of the foot centre (+ ahead) and to Reachy's left (+ left; the arm
#     stands on Reachy's left, so expect +).
#  3. ARM_BASE_YAW_DEG: with the arm limp, turn it by hand until `scripts/arm.sh fk` shows
#     shoulder_pan ≈ 0; the direction it then reaches, in degrees from Reachy's forward line,
#     + counter-clockwise seen from above (toward Reachy's left). Or: the direction it reaches
#     at rest minus 5 (rest has shoulder_pan −5.05°, about 5° counter-clockwise of pan 0).
#  4. ARM_BASE_Z_CM: the underside of the arm's base above the table under Reachy (0 when
#     both stand on the same table). With its motors on, the arm carries its own weight and
#     sits a few mm lower than a limp `scripts/arm.sh fk` check shows (the links flex, the
#     joints have play, and the encoders can't see either): lower Z by that much, e.g. if a
#     grasp's jaws touch the table while it prints them ~5 mm above, take 0.5 off.
# Arm tasks stay off until X, Y and YAW are all set.
# ARM_BASE_X_CM=
# ARM_BASE_Y_CM=
# ARM_BASE_YAW_DEG=
# ARM_BASE_Z_CM=0
# The arm's elbow, wrist, gripper and jaw tips stay at least this far (cm, horizontally) from
# the centre of Reachy's foot; the arm's shells reach up to about 2.5 cm closer, so leave that
# much margin (the default 16 clears the 6.3 cm foot with plenty to spare).
# ARM_KEEPOUT_CM=16
# Degrees added to LeRobot's joint angles to get the URDF's, for shoulder_pan, shoulder_lift,
# elbow_flex, wrist_flex, wrist_roll (calibration vs URDF zero; fitted with scripts/arm.sh fk).
# ARM_JOINT_OFFSETS_DEG=0,0,0,0,0
# wrist_roll is never sent past ± this many degrees (it once overloaded against its cable).
# ARM_ROLL_LIMIT_DEG=90
# The SO-101 URDF, with its assets/ meshes next to it. Default: the repo's
# third_party/so101/so101_new_calib.urdf; set an absolute path to use another copy.
# ARM_URDF=/path/to/so101_new_calib.urdf

# Optional: custom system prompt (single line, will override the default)
# GEMINI_SYSTEM_PROMPT=You are Reachy, a friendly robot. Be concise and warm.
